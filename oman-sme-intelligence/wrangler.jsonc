{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oman-sme-intel",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "docs"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oman-sme-intel",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
